# ------------------------------------------------------------------------------
# Base "lab" — a base principal do lab (core `protheus_core`, porta 1234).
# ------------------------------------------------------------------------------
# Criada no mesmo protheus_postgres com os parametros do
# databases/postgres/init-protheus.sh:
#
#   CREATE DATABASE protheus_lab WITH OWNER=totvs TEMPLATE=template0
#     ENCODING='WIN1252' LC_COLLATE='C' LC_CTYPE='pt_BR.CP1252' CONNECTION LIMIT=-1;
#
# Nasce sem dicionario: quem o cria e o dialogo de primeiro boot do WebApp (empresa
# e filial de teste), que nao da para automatizar; o tipo de ambiente
# (Desenvolvimento) e definido no SIGACFG.
DB_NAME=protheus_lab

# Um core por base (desde 2026-10-05): qual core/volumes/porta pertencem a esta base.
# Lidos pelo run.sh (base, jobs) e pelo test-local.sh. O core desta base roda SEMPRE
# nesta base; `./run.sh base lab` so o escolhe como alvo (e o sobe, se preciso).
LAB_SERVICE=appserver_core
LAB_CONTAINER=protheus_core
LAB_SYSTEM_VOL=protheus_system
LAB_DATA_VOL=protheus_data
LAB_LOG_VOL=protheus_log
LAB_GENERATED=appserver/generated
LAB_PORT=1234
# License Server proprio deste lab (vazio = usa o license_server compartilhado do lab principal,
# que tambem atende o dbaccess e por isso nunca e parado pelo `./run.sh base <lab> stop`).
LAB_LICENSE_SERVICE=
LAB_PROFILE=
