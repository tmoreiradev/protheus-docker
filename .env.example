# Variáveis Globais de Ambiente
ENV_NAME=protheus_dev

# Governança de Infraestrutura (Novas Variáveis)
DBACCESS_PORT=7890
DBACCESS_SERVER=protheus_dbaccess
LICENSE_SERVER=protheus_license
LICENSE_SERVER_PORT=5555

# Configurações de Portas Multiprotocolo (TCP/WebApp)
CORE_PORT_MULTI=1234

# Portas Especialistas de Serviços Dedicados
APP_MONITOR_PORT=32033

# Parametrização Dedicada do Barramento REST API
REST_HTTP_PORT=8400
REST_URI=/rest
REST_PREP_ENV=99,01
REST_INSTANCES=1,1
# --- Banco de dados ativo ---
# Seletor: o run.sh le esta chave quando voce omite o SGBD no comando
# (./run.sh, ./run.sh compile). Nao configura a conexao: DB_SERVER, DB_PORT e
# as credenciais root vem do .env.<sgbd>, que sobrescreve esta chave.
# Valores: POSTGRES | MSSQL | ORACLE
DB_TYPE=POSTGRES

# --- Senha do admin do Protheus ---
# Usada pelo job upddistr, que roda headless e NAO pode cair na troca obrigatoria
# de senha. Numa base nova: entre uma vez pelo WebApp como admin, defina a senha
# (min. 8 caracteres, com maiuscula, minuscula, numero e especial) e replique aqui.
UPD_PASSWORD=
