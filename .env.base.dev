# ------------------------------------------------------------------------------
# Base "dev" — base de desenvolvimento (profile `dev`, desligada por padrao).
# ------------------------------------------------------------------------------
# Lida por `./run.sh base dev`. A unica chave que muda entre bases e o DB_NAME:
# ele e o nome do banco no Postgres E o alias do dbAccess (o entrypoint do
# dbaccess registra `environments=${DB_NAME}`) E o DBAlias do appserver.ini.
#
# O ENV_NAME (nome do ambiente do AppServer) NAO muda de proposito: o
# test-local.sh e a sonda do -run= usam `-env=protheus_dev`. Trocar o ENV_NAME
# junto com a base deixaria esses dois apontando para uma secao inexistente.
DB_NAME=protheus_dev

# Um core por base (desde 2026-10-05): qual core/volumes/porta pertencem a esta base.
# Lidos pelo run.sh (base, jobs) e pelo test-local.sh. O core desta base roda SEMPRE
# nesta base; `./run.sh base dev` so o escolhe como alvo (e o sobe, se preciso).
LAB_SERVICE=appserver_core_dev
LAB_CONTAINER=protheus_core_dev
LAB_SYSTEM_VOL=protheus_system_dev
LAB_DATA_VOL=protheus_data_dev
LAB_LOG_VOL=protheus_log_dev
LAB_GENERATED=appserver/generated-dev
LAB_PORT=1237
# License Server proprio deste lab (vazio = usa o license_server compartilhado do lab principal,
# que tambem atende o dbaccess e por isso nunca e parado pelo `./run.sh base <lab> stop`).
LAB_LICENSE_SERVICE=license_server_dev
LAB_PROFILE=dev
