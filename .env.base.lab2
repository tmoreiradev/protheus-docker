# ------------------------------------------------------------------------------
# Base "lab2" — exemplo de segunda base, com core, volumes e License Server proprios.
# ------------------------------------------------------------------------------
# Mesmos parametros do databases/postgres/init-protheus.sh (WIN1252, LC_COLLATE C,
# LC_CTYPE pt_BR.CP1252). Use para isolar um dicionario diferente do lab principal.
DB_NAME=protheus_lab2

# Um core por base (desde 2026-10-05): qual core/volumes/porta pertencem a esta base.
# Lidos pelo run.sh (base, jobs) e pelo test-local.sh. O core desta base roda SEMPRE
# nesta base; `./run.sh base lab2` so o escolhe como alvo (e o sobe, se preciso).
LAB_SERVICE=appserver_core_lab2
LAB_CONTAINER=protheus_core_lab2
LAB_SYSTEM_VOL=protheus_system_lab2
LAB_DATA_VOL=protheus_data_lab2
LAB_LOG_VOL=protheus_log_lab2
LAB_GENERATED=appserver/generated-lab2
LAB_PORT=1236
# License Server proprio deste lab (vazio = usa o license_server compartilhado do lab principal,
# que tambem atende o dbaccess e por isso nunca e parado pelo `./run.sh base <lab> stop`).
LAB_LICENSE_SERVICE=license_server_lab2
LAB_PROFILE=
